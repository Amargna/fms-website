---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <h1>Crafting worlds worth playing</h1>
      <p>
        [Your Gaming Company] is an independent studio building [genre]-driven games for players
        who want more than just a pastime.
      </p>
      <div class="hero-actions">
        <a href="/products" class="btn btn-primary">View Our Games</a>
        <a href="/projects" class="btn btn-secondary">See Our Work</a>
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="section">
    <h2>Featured Products</h2>
    <p class="section-subtitle">A look at what we've built.</p>
    <div class="card-grid">
      <a href="/products" class="card">
        <div class="card-thumb">[Game Cover]</div>
        <h3>[Game Title 1]</h3>
        <p>One-line hook — genre, platform, what makes it stand out.</p>
        <span class="card-link">Learn More →</span>
      </a>
      <a href="/products" class="card">
        <div class="card-thumb">[Game Cover]</div>
        <h3>[Game Title 2]</h3>
        <p>One-line hook — genre, platform, what makes it stand out.</p>
        <span class="card-link">Learn More →</span>
      </a>
      <a href="/products" class="card">
        <div class="card-thumb">[Game Cover]</div>
        <h3>[Game Title 3]</h3>
        <p>One-line hook — genre, platform, what makes it stand out.</p>
        <span class="card-link">Learn More →</span>
      </a>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section section-alt">
    <h2>Featured Projects</h2>
    <p class="section-subtitle">Selected client and co-development work.</p>
    <div class="card-grid">
      <a href="/projects" class="card">
        <div class="card-thumb">[Project Thumbnail]</div>
        <h3>[Project Name 1]</h3>
        <p>Client/type of engagement, and the outcome in one line.</p>
        <span class="card-link">View Case Study →</span>
      </a>
      <a href="/projects" class="card">
        <div class="card-thumb">[Project Thumbnail]</div>
        <h3>[Project Name 2]</h3>
        <p>Client/type of engagement, and the outcome in one line.</p>
        <span class="card-link">View Case Study →</span>
      </a>
      <a href="/projects" class="card">
        <div class="card-thumb">[Project Thumbnail]</div>
        <h3>[Project Name 3]</h3>
        <p>Client/type of engagement, and the outcome in one line.</p>
        <span class="card-link">View Case Study →</span>
      </a>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="section">
    <h2>Services</h2>
    <p class="section-subtitle">From concept to launch, we partner with studios and publishers.</p>
    <div class="services-grid">
      <div class="service-item">
        <div class="service-icon">✏️</div>
        <h3>Game Design</h3>
        <p>Concepting, prototyping, and design systems for new titles.</p>
      </div>
      <div class="service-item">
        <div class="service-icon">💻</div>
        <h3>Development</h3>
        <p>Full-cycle development across PC, console, and mobile.</p>
      </div>
      <div class="service-item">
        <div class="service-icon">🚀</div>
        <h3>Publishing</h3>
        <p>Bringing finished titles to market across major storefronts.</p>
      </div>
      <div class="service-item">
        <div class="service-icon">🤝</div>
        <h3>Co-Development</h3>
        <p>Partnering with other studios on scope, art, or engineering.</p>
      </div>
    </div>
  </section>

  <!-- Contact Bar -->
  <section class="contact-bar">
    <h2>Let's get in touch?</h2>
    <p>Have a project in mind, or want to talk about one of our games? We'd love to hear from you.</p>
    <a href="/contact" class="btn btn-primary">Get in Touch</a>
  </section>
</Layout>

<style>
  .hero {
    background: #111;
    color: #fff;
    padding: 6rem 1.5rem;
    text-align: center;
  }
  .hero-content {
    max-width: 700px;
    margin: 0 auto;
  }
  .hero h1 {
    font-size: 2.75rem;
    margin-bottom: 1rem;
  }
  .hero p {
    font-size: 1.1rem;
    color: #ccc;
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .btn-primary {
    background: #6d28d9;
    color: #fff;
  }
  .btn-primary:hover {
    background: #5b21b6;
    transform: translateY(-2px);
  }
  .btn-secondary {
    background: transparent;
    color: #fff;
    border: 1px solid #555;
  }
  .btn-secondary:hover {
    border-color: #fff;
    transform: translateY(-2px);
  }

  .section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
    text-align: center;
  }
  .section-alt {
    background: #f9f8fc;
  }
  .section h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  .section-subtitle {
    color: #666;
    margin-bottom: 2.5rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    text-align: left;
  }
  .card {
    border: 1px solid #eee;
    border-radius: 10px;
    padding: 1.25rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    display: block;
  }
  .card:hover {
    transform: scale(1.02);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }
  .card-thumb {
    background: #e5e5e5;
    height: 140px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #999;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  .card h3 {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }
  .card p {
    color: #555;
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }
  .card-link {
    color: #6d28d9;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    text-align: center;
  }
  .service-item {
    padding: 1.5rem 1rem;
  }
  .service-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }
  .service-item h3 {
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
  }
  .service-item p {
    color: #666;
    font-size: 0.9rem;
  }

  .contact-bar {
    background: #6d28d9;
    color: #fff;
    text-align: center;
    padding: 4rem 1.5rem;
  }
  .contact-bar h2 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .contact-bar p {
    margin-bottom: 1.5rem;
    color: #ede9fe;
  }
  .contact-bar .btn-primary {
    background: #fff;
    color: #6d28d9;
  }
  .contact-bar .btn-primary:hover {
    background: #f3f0ff;
  }

  @media (max-width: 768px) {
    .card-grid,
    .services-grid {
      grid-template-columns: 1fr;
    }
    .hero h1 {
      font-size: 2rem;
    }
  }
</style>