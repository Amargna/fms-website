---
// src/layouts/PageLayout.astro
import Layout from '~/layouts/Layout.astro';
import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
---

<Layout metadata={metadata}>
  <!-- Announcement Banner -->
  <div class="announcement" id="announcement">
    <span>🎮 New game launching next week — stay tuned!</span>
    <button id="closeAnnouncement" aria-label="Dismiss announcement">&times;</button>
  </div>

  <!-- Header -->
  <header class="site-header" id="siteHeader">
    <div class="header-inner">
      <a href="/" class="logo">[Your Gaming Company]</a>

      <nav class="main-nav" id="mainNav">
        <a href="/">Home</a>
        <a href="/services">Services</a>
        <a href="/products">Products</a>
        <a href="/projects">Projects</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>

      <button class="hamburger" id="hamburgerBtn" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <p class="logo">[Your Gaming Company]</p>
        <div class="social-icons">
          <a href="#" aria-label="X">X</a>
          <a href="#" aria-label="Discord">Discord</a>
          <a href="#" aria-label="YouTube">YouTube</a>
        </div>
      </div>
      <div class="footer-legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <p>&copy; 2026 [Your Gaming Company]. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script>
    // Dismiss announcement banner
    const banner = document.getElementById('announcement');
    const closeBtn = document.getElementById('closeAnnouncement');
    closeBtn?.addEventListener('click', () => {
      banner?.remove();
    });

    // Sticky header shrink on scroll
    const header = document.getElementById('siteHeader');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        header?.classList.add('scrolled');
      } else {
        header?.classList.remove('scrolled');
      }
    });

    // Mobile hamburger menu toggle
    const hamburger = document.getElementById('hamburgerBtn');
    const nav = document.getElementById('mainNav');
    hamburger?.addEventListener('click', () => {
      nav?.classList.toggle('open');
      hamburger?.classList.toggle('active');
    });

    // Highlight active page in nav
    const currentPath = window.location.pathname;
    document.querySelectorAll('.main-nav a').forEach((link) => {
      if (link.getAttribute('href') === currentPath) {
        link.classList.add('active');
      }
    });
  </script>

  <style is:global>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      color: #1a1a1a;
      line-height: 1.5;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* Announcement banner */
    .announcement {
      background: #111;
      color: #fff;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
      text-align: center;
    }
    .announcement button {
      background: none;
      border: none;
      color: #fff;
      font-size: 1.1rem;
      cursor: pointer;
      line-height: 1;
    }

    /* Header */
    .site-header {
      position: sticky;
      top: 0;
      background: #fff;
      border-bottom: 1px solid #eee;
      z-index: 100;
      transition: box-shadow 0.2s ease;
    }
    .site-header.scrolled {
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }
    .header-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.5rem;
    }
    .logo {
      font-weight: 700;
      font-size: 1.1rem;
    }
    .main-nav {
      display: flex;
      gap: 1.5rem;
    }
    .main-nav a {
      font-size: 0.95rem;
      font-weight: 500;
      color: #333;
    }
    .main-nav a.active {
      color: #6d28d9;
    }
    .main-nav a:hover {
      color: #6d28d9;
    }

    /* Hamburger (hidden on desktop) */
    .hamburger {
      display: none;
      flex-direction: column;
      justify-content: space-between;
      width: 24px;
      height: 18px;
      background: none;
      border: none;
      cursor: pointer;
    }
    .hamburger span {
      display: block;
      height: 2px;
      width: 100%;
      background: #333;
    }

    /* Footer */
    .site-footer {
      background: #111;
      color: #ccc;
      margin-top: 4rem;
    }
    .footer-inner {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 1.5rem;
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 2rem;
    }
    .footer-brand .logo {
      color: #fff;
      margin-bottom: 1rem;
      display: block;
    }
    .social-icons {
      display: flex;
      gap: 1rem;
    }
    .social-icons a {
      color: #ccc;
      font-size: 0.85rem;
    }
    .footer-legal {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      font-size: 0.85rem;
    }
    .footer-legal a {
      color: #ccc;
    }

    /* Mobile */
    @media (max-width: 768px) {
      .main-nav {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #fff;
        flex-direction: column;
        padding: 1rem 1.5rem;
        display: none;
        border-bottom: 1px solid #eee;
      }
      .main-nav.open {
        display: flex;
      }
      .hamburger {
        display: flex;
      }
      .announcement {
        display: none;
      }
    }
  </style>
</Layout>